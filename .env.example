# Meu Financeiro
# Copie para .env e preencha localmente. Nunca envie valores reais ao GitHub.

PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pierre Finance
PIERRE_API_KEY=

# Meu Financeiro V3 — mercado
# Token da Brapi. Necessário para consultar toda a carteira (ex.: MXRF11/XPML11).
BRAPI_TOKEN=

# Apenas informativo para a interface. Ajuste se o seu plano/fonte tiver outra defasagem.
BRAPI_DELAY_MINUTES=30

# Bancos internacionais — Wise
# Token apenas para credenciais Wise compatíveis (normalmente Wise Business/Partner).
# Nunca exponha no frontend.
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_API_BASE_URL=https://api.wise.com/2026Q4

# Investimentos Nubank — Belvo Open Finance (opcional)
# Produção exige credenciais e um link/consentimento válido da instituição.
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_LINK_ID_NUBANK=
BELVO_API_BASE_URL=https://api.belvo.com
